# Everything this repo installs, in dependency order, rendered with the site directory: $CAIRN_SITE
# (absolute), else the repo root. The releases come from data, so adding a component or an app
# doesn't touch this file:
#   infrastructure/<name>/component.yaml  base always; the others when site.yaml's
#                                         infrastructure.<name> is true
#   apps.<name> in site.yaml              one app each, defined by apps/<app>/app.yaml (app: in
#                                         the entry, else its name), or by chart: in the entry
#
#   helmfile diff     what would change (needs the helm-diff plugin)
#   helmfile apply    install or upgrade what changed
#
# Uses $KUBECONFIG, else ~/.kube/config.
{{- $site := env "CAIRN_SITE" | default "." }}
environments:
  default:
    values:
      - {{ $site }}/site.yaml
---
{{- $site := env "CAIRN_SITE" | default "." }}
{{- $infra := .Values.infrastructure | default dict }}
{{- $apps := .Values.apps | default dict }}
{{- $acme := .Values.acme | default dict }}
{{- /* Conditions a component's release can name in when:. */}}
{{- $when := dict "gandiSolver" (has "gandi" (append (values ($acme.zones | default dict)) ($acme.defaultSolver | default ""))) }}

{{- $components := list "base" }}
{{- range $name, $on := $infra }}
{{- if not (kindIs "bool" $on) }}{{ fail (printf "infrastructure.%s must be true or false (site.yaml)" $name) }}{{ end }}
{{- if not (isFile (printf "infrastructure/%s/component.yaml" $name)) }}{{ fail (printf "infrastructure.%s (site.yaml): there's no infrastructure/%s/component.yaml" $name $name) }}{{ end }}
{{- if $on }}{{ $components = append $components $name }}{{ end }}
{{- end }}

{{- $releases := list }}
{{- $repos := dict }}
{{- /* Read here only for the apps' sections, which each app gets on its own (apps.<name>). */}}
{{- $secrets := dict }}
{{- if isFile (printf "%s/site.secret.yaml" $site) }}{{ $secrets = readFile (printf "%s/site.secret.yaml" $site) | fromYaml | default dict }}{{ end }}

{{- /* Components. A local chart gets site.yaml (and site.secret.yaml), a third-party one its
       <release>.yaml; both then get the site's values/<release>.yaml. */}}
{{- range $c := $components }}
{{- $dir := printf "infrastructure/%s" $c }}
{{- $spec := readFile (printf "%s/component.yaml" $dir) | fromYaml }}
{{- range $name, $url := $spec.repositories | default dict }}{{ $_ := set $repos $name $url }}{{ end }}
{{- range $r := $spec.releases }}
{{- if or (not (hasKey $r "when")) (index $when $r.when) }}
{{- $values := list }}
{{- if hasKey $r "site" }}
{{- $values = append $values (printf "%s/site.yaml" $site) }}
{{- if and (eq $r.site "secrets") (isFile (printf "%s/site.secret.yaml" $site)) }}{{ $values = append $values (printf "%s/site.secret.yaml" $site) }}{{ end }}
{{- else if isFile (printf "%s/%s.yaml" $dir $r.name) }}
{{- $values = append $values (printf "%s/%s.yaml" $dir $r.name) }}
{{- end }}
{{- if isFile (printf "%s/values/%s.yaml" $site $r.name) }}{{ $values = append $values (printf "%s/values/%s.yaml" $site $r.name) }}{{ end }}
{{- $chart := $r.chart }}
{{- if hasPrefix "./" $chart }}{{ $chart = printf "./%s/%s" $dir (trimPrefix "./" $chart) }}{{ end }}
{{- $rel := dict "name" $r.name "namespace" $r.namespace "chart" $chart "labels" (dict "component" $c) "needs" (get "needs" list $r) "values" $values }}
{{- if hasKey $r "version" }}{{ $_ := set $rel "version" $r.version }}{{ end }}
{{- if hasKey $r "timeout" }}{{ $_ := set $rel "timeout" $r.timeout }}{{ end }}
{{- $releases = append $releases $rel }}
{{- end }}
{{- end }}
{{- end }}

{{- /* Apps: the entry in site.yaml over apps/<app>/app.yaml. The chart: the entry's chart:, else
       apps/<app>/chart/, else charts/app with apps/<app>/values.yaml (or the entry's values:).
       Release <name> in namespace <name> gets site.yaml, those values files, the entry itself (its
       site settings, and any chart value to override), then its section of site.secret.yaml.
       A database adds release postgres in the same namespace. */}}
{{- range $name, $entry := $apps }}
{{- $entry = $entry | default dict }}
{{- if not (kindIs "map" $entry) }}{{ fail (printf "apps.%s must be a map (site.yaml)" $name) }}{{ end }}
{{- $dir := printf "apps/%s" (get "app" $name $entry) }}
{{- $spec := dict }}
{{- if isFile (printf "%s/app.yaml" $dir) }}{{ $spec = readFile (printf "%s/app.yaml" $dir) | fromYaml }}
{{- else if hasKey $entry "app" }}{{ fail (printf "apps.%s.app (site.yaml): there's no %s/app.yaml" $name $dir) }}{{ end }}
{{- $spec = mergeOverwrite $spec (deepCopy $entry) }}
{{- $needs := list "kube-system/cluster" }}
{{- if hasKey $spec "database" }}
{{- if not (get "postgres" false $infra) }}{{ fail (printf "apps.%s.database needs infrastructure.postgres (site.yaml)" $name) }}{{ end }}
{{- $db := $spec.database | default dict }}
{{- $dbValues := dict }}
{{- if hasKey $db "size" }}{{ $_ := set $dbValues "storage" (dict "size" $db.size) }}{{ end }}
{{- if hasKey $db "image" }}{{ $_ := set $dbValues "image" $db.image }}{{ end }}
{{- $releases = append $releases (dict "name" "postgres" "namespace" $name "chart" "./charts/postgres-cluster" "timeout" 600 "labels" (dict "app" $name) "needs" (list "cnpg-system/cloudnative-pg") "values" (list (printf "%s/site.yaml" $site) $dbValues)) }}
{{- $needs = append $needs (printf "%s/postgres" $name) }}
{{- end }}
{{- $chart := get "chart" "" $spec }}
{{- $values := list (printf "%s/site.yaml" $site) }}
{{- if not $chart }}
{{- if isDir (printf "%s/chart" $dir) }}{{ $chart = printf "./%s/chart" $dir }}
{{- else if isFile (printf "%s/values.yaml" $dir) }}{{ $chart = "./charts/app" }}{{ $values = append $values (printf "./%s/values.yaml" $dir) }}
{{- else if hasKey $spec "values" }}{{ $chart = "./charts/app" }}{{ end }}
{{- end }}
{{- if $chart }}
{{- if and (or (hasPrefix "oci://" $chart) (contains "::" $chart)) (not (hasKey $spec "version")) (not (contains "ref=" $chart)) }}
{{- fail (printf "apps.%s.chart (site.yaml): pin it, with version: or ?ref= in a git URL" $name) }}
{{- end }}
{{- range $v := get "values" list $spec }}
{{- if and (contains "::" $v) (not (contains "ref=" $v)) }}{{ fail (printf "apps.%s.values (site.yaml): pin %s with ?ref=" $name $v) }}{{ end }}
{{- $values = append $values $v }}
{{- end }}
{{- $values = append $values (omit $entry "app" "chart" "version" "values" "timeout" "needs") }}
{{- with get (printf "apps.%s" $name) dict $secrets }}{{ $values = append $values . }}{{ end }}
{{- $rel := dict "name" $name "namespace" $name "chart" $chart "labels" (dict "app" $name) "needs" (concat $needs (get "needs" list $spec)) "values" $values }}
{{- if hasKey $spec "version" }}{{ $_ := set $rel "version" $spec.version }}{{ end }}
{{- if hasKey $spec "timeout" }}{{ $_ := set $rel "timeout" $spec.timeout }}{{ end }}
{{- $releases = append $releases $rel }}
{{- end }}
{{- end }}

{{- /* needs: only releases that are installed. */}}
{{- $ids := dict }}
{{- range $r := $releases }}{{ $_ := set $ids (printf "%s/%s" $r.namespace $r.name) true }}{{ end }}
{{- range $r := $releases }}
{{- $keep := list }}
{{- range $n := $r.needs }}{{ if hasKey $ids $n }}{{ $keep = append $keep $n }}{{ end }}{{ end }}
{{- $_ := set $r "needs" $keep }}
{{- end }}

helmDefaults:
  wait: true
  timeout: 300
  createNamespace: true

repositories:
{{- range $name, $url := $repos }}
  - name: {{ $name }}
    url: {{ $url }}
{{- end }}

releases:
{{- toYaml $releases | nindent 2 }}
